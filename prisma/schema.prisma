// Prisma Schema — 左文科技后台管理系统
// 数据库：PostgreSQL 17
// 本文件为核心表（M1 基础建设），内容表在 M2/M3 阶段扩展

generator client {
  provider = "prisma-client-js"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// 1. 用户权限域
// ============================================================

model User {
  id           BigInt     @id @default(autoincrement())
  username     String     @unique @db.VarChar(50)
  email        String?    @unique @db.VarChar(100)
  phone        String?    @db.VarChar(20)
  passwordHash String     @db.VarChar(255)
  displayName  String     @db.VarChar(50)
  avatar       String?    @db.VarChar(500)
  status       String     @default("active") @db.VarChar(20) // active/disabled
  // 销售跟进标记（商城订单分配/轮转）：isSales=是否参与订单跟进，salesOrder=轮转顺序（小优先）
  isSales      Boolean    @default(false)
  salesOrder   Int        @default(0)
  lastLoginAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  userRoles    UserRole[]
  operationLogs OperationLog[]
  shopOrders   ShopOrder[] @relation("ShopOrderSales")
  // 销售绑定的商城产品（隐式多对多 _UserToShopProduct）：仅绑定产品的订单才有权限接待
  salesProducts ShopProduct[]

  createdNews News[]

  @@map("users")
}

// 前台会员（会员中心插件）：独立于后台 User 的鉴权体系（HMAC token cookie，与 admin NextAuth 隔离）
model Member {
  id           BigInt    @id @default(autoincrement())
  email        String    @unique @db.VarChar(100)
  passwordHash String    @db.VarChar(255)
  name         String    @default("") @db.VarChar(50)
  phone        String?   @db.VarChar(20)
  // 米思米式 B 端客户画像
  company      String?   @db.VarChar(200) // 公司名称
  industry     String?   @db.VarChar(50) // 所属行业（semiconductor/jewelry/optical/...）
  country      String?   @db.VarChar(50) // 国家/地区
  customerNo   String?   @unique @db.VarChar(30) // 客户编号，如 ZW-000001（注册/后台创建自动生成）
  companyVerified Json? // 公司真实性核验结果 {exists, confidence, reason, verified, checkedAt}
  status       String    @default("active") @db.VarChar(20) // active/disabled
  locale       String?   @default("zh") @db.VarChar(10)
  level        String    @default("normal") @db.VarChar(30) // 会员等级 key（normal/silver/gold/black 或自定义）
  customerType String    @default("inquiry") @db.VarChar(30) // 客户分类 key（inquiry/machine/material/parts，见 customer_types）
  points       Int       @default(0) // 积分
  // 发票与收货信息（米思米式会员中心）
  invoiceTitle String?   @db.VarChar(200) // 默认发票抬头
  taxNo        String?   @db.VarChar(50) // 默认税号
  invoiceEmail String?   @db.VarChar(100) // 发票接收邮箱
  address      Json? // 默认收货地址 {name, phone, province, city, district, detail}
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  favorites MemberFavorite[]

  @@map("members")
}
model MemberLevel {
  id          BigInt   @id @default(autoincrement())
  key         String   @unique @db.VarChar(30) // normal/silver/gold/black 或自定义
  name        String   @db.VarChar(50)
  nameEn      String?  @db.VarChar(50)
  nameJa      String?  @db.VarChar(50)
  nameKo      String?  @db.VarChar(50)
  nameFr      String?  @db.VarChar(50)
  nameAr      String?  @db.VarChar(50)
  threshold   Int      @default(0) // 升级所需积分门槛
  discount    Int      @default(0) // 等级折扣（0-100，百分数）
  benefits    String?  @db.Text // 权益描述（中文，支持换行）
  benefitsEn  String?  @db.Text
  benefitsJa  String?  @db.Text
  benefitsKo  String?  @db.Text
  benefitsFr  String?  @db.Text
  benefitsAr  String?  @db.Text
  sortOrder   Int      @default(0)
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("member_levels")
}

model CustomerType {
  id          BigInt   @id @default(autoincrement())
  key         String   @unique @db.VarChar(30) // inquiry/machine/material/parts 或自定义
  name        String   @db.VarChar(50)
  nameEn      String?  @db.VarChar(50)
  nameJa      String?  @db.VarChar(50)
  nameKo      String?  @db.VarChar(50)
  nameFr      String?  @db.VarChar(50)
  nameAr      String?  @db.VarChar(50)
  discount    Int      @default(0) // 该客户类型折扣（0-100 百分数，0=无折扣）
  seePartsPrice Boolean @default(false) // 是否可见配件价格
  isDefault   Boolean  @default(false) // 新注册会员默认类型
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("customer_types")
}


// 客户门户工单（customer-portal 插件）
model Ticket {
  id          BigInt   @id @default(autoincrement())
  ticketNo    String   @unique @db.VarChar(30) // 工单号 TK20260906-0001
  memberId    BigInt?  // 关联会员（门户提交）
  customerName String  @default("") @db.VarChar(100)
  contactEmail String  @default("") @db.VarChar(100)
  category    String   @default("general") @db.VarChar(50) // general/授权/手册/报价/其他
  subject     String   @db.VarChar(200)
  content     String   @db.Text
  reply       String?  @db.Text          // 后台回复
  status      String   @default("open") @db.VarChar(20) // open待处理/replied已回复/closed已关闭
  priority    String   @default("normal") @db.VarChar(20)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([memberId])
  @@index([status])
  @@map("tickets")
}

model MemberFavorite {
  id        BigInt   @id @default(autoincrement())
  memberId  BigInt
  productId BigInt
  createdAt DateTime @default(now())

  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([memberId, productId])
  @@index([memberId])
  @@map("member_favorites")
}

model Role {
  id          BigInt   @id @default(autoincrement())
  name        String   @unique @db.VarChar(50) // admin / editor
  displayName String   @db.VarChar(50)
  description String?  @db.VarChar(200)
  createdAt   DateTime @default(now())

  userRoles       UserRole[]
  rolePermissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          BigInt   @id @default(autoincrement())
  code        String   @unique @db.VarChar(100) // e.g. product:create
  name        String   @db.VarChar(50)
  module      String   @db.VarChar(30)
  action      String   @db.VarChar(20)
  createdAt   DateTime @default(now())

  rolePermissions RolePermission[]

  @@map("permissions")
}

model UserRole {
  userId BigInt
  roleId BigInt
  assignedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       BigInt
  permissionId BigInt
  assignedAt   DateTime @default(now())

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

// ============================================================
// 2. 产品域（核心内容）
// ============================================================

model ProductTab {
  id        BigInt   @id @default(autoincrement())
  siteId    BigInt?  // 所属站点（null=全局共享）
  slug      String   @unique @db.VarChar(50) // growth/auxiliary/diamonds/materials
  name      String   @db.VarChar(100)
  nameEn    String?  @db.VarChar(100)
  nameJa    String?  @db.VarChar(100)
  nameKo    String?  @db.VarChar(100)
  nameFr    String?  @db.VarChar(100)
  nameAr    String?  @db.VarChar(100)
  purchaseMode String   @default("quote") @db.VarChar(20) // quote=询价 / shop=商城购买
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  categories ProductCategory[]
  products   Product[]

  @@map("product_tabs")
}

model ProductCategory {
  id        BigInt   @id @default(autoincrement())
  siteId    BigInt?  // 所属站点（null=全局共享）
  tabId     BigInt
  slug      String   @db.VarChar(50)
  name      String   @db.VarChar(100)
  nameEn    String?  @db.VarChar(100)
  nameJa    String?  @db.VarChar(100)
  nameKo    String?  @db.VarChar(100)
  nameFr    String?  @db.VarChar(100)
  nameAr    String?  @db.VarChar(100)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  tab      ProductTab @relation(fields: [tabId], references: [id], onDelete: Cascade)
  products Product[]

  @@unique([tabId, slug])
  @@map("product_categories")
}
model Product {
  siteId       BigInt?  // 所属站点（null=全局共享，多租户数据隔离）
  id           BigInt   @id @default(autoincrement())
  tabId        BigInt
  categoryId   BigInt?
  slug         String   @unique @db.VarChar(100)
  model        String   @db.VarChar(100) // 型号，如 ZW-10D
  name         String   @db.VarChar(200)
  nameEn       String?  @db.VarChar(200)
  nameJa       String?  @db.VarChar(200)
  nameKo       String?  @db.VarChar(200)
  nameFr       String?  @db.VarChar(200)
  nameAr       String?  @db.VarChar(200)
  subtitle     String?  @db.VarChar(500)
  subtitleEn   String?  @db.VarChar(500)
  subtitleJa   String?  @db.VarChar(500)
  subtitleKo   String?  @db.VarChar(500)
  subtitleFr   String?  @db.VarChar(500)
  subtitleAr   String?  @db.VarChar(500)
  summary      String?  @db.Text
  summaryEn    String?  @db.Text
  summaryJa    String?  @db.Text
  summaryKo    String?  @db.Text
  summaryFr    String?  @db.Text
  summaryAr    String?  @db.Text
  description  String?  @db.Text // 富文本/HTML
  descriptionEn String? @db.Text // 英文详细描述
  descriptionJa String? @db.Text // 日文详细描述
  descriptionKo String? @db.Text // 韩文详细描述
  descriptionFr String? @db.Text // 法文详细描述
  descriptionAr String? @db.Text // 阿拉伯文详细描述
  features     Json?    // 特性列表
  featuresEn   Json?    // 英文特性列表
  featuresJa   Json?    // 日文特性列表
  featuresKo   Json?    // 韩文特性列表
  featuresFr   Json?    // 法文特性列表
  featuresAr   Json?    // 阿拉伯文特性列表
  images       Json?    // 图片列表 [{url, alt}]
  price        Decimal? @db.Decimal(12,2) // 参考价（受价格显示策略控制）
  priceTiers   Json?    // 阶梯价 [{qty, price}] 批量价
  isParts      Boolean  @default(false) // 是否配件（配件价仅整机/配件客户可见）
  coverImage   String?  @db.VarChar(500)
  video        String?  @db.VarChar(500)
  frames360    Json?    // {template, totalFrames, startIndex}
  manualUrl    String?  @db.VarChar(500) // 产品手册下载链接
  // 询价/报价字段（2026-09-04 RFQ 自动报价）
  priceMin     Decimal? @db.Decimal(12,2) // 参考价下限（人民币元）
  priceMax     Decimal? @db.Decimal(12,2) // 参考价上限（空=单值；两者都空=面议）
  priceUnit    String?  @db.VarChar(20)   // 价格单位，默认"元/台"
  moq          Int?     @default(1)       // 最小起订量
  priceNote    String?  @db.VarChar(300)  // 价格备注（含税/运费等）
  priceNoteEn  String?  @db.VarChar(300)
  priceNoteJa  String?  @db.VarChar(300)
  priceNoteKo  String?  @db.VarChar(300)
  priceNoteFr  String?  @db.VarChar(300)
  priceNoteAr  String?  @db.VarChar(300)
  specs        Json?    // 规格参数（兼容旧数据）
  sortOrder    Int      @default(0)
  status       String   @default("published") @db.VarChar(20) // published/draft
  // 前台显示开关（owner 2026-10-10「可以设定产品是否在前台显示」）。
  //   false = 后台保留（数据/规格/询价记录都不丢），但前台**列表 / 详情页 / 相关产品 /
  //   猜你喜欢 / sitemap / llms.txt / 百度推送 / AI 客服知识**一律不出现；
  //   与 status（published/draft）的分工：草稿=「还没做完」，visible=false=「做完了但不对外」。
  visible      Boolean  @default(true)
  publishedAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  // SEO/GEO字段
  seoTitle     String?  @db.VarChar(200)
  seoTitleJa   String?  @db.VarChar(200)
  seoTitleKo   String?  @db.VarChar(200)
  seoTitleFr   String?  @db.VarChar(200)
  seoTitleAr   String?  @db.VarChar(200)
  seoTitleEn   String?  @db.VarChar(200)
  seoDescription String? @db.Text
  seoDescriptionJa String?  @db.Text
  seoDescriptionKo String?  @db.Text
  seoDescriptionFr String?  @db.Text
  seoDescriptionAr String?  @db.Text
  seoDescriptionEn String? @db.Text
  seoKeywords  String?  @db.Text
  seoKeywordsJa String?  @db.Text
  seoKeywordsKo String?  @db.Text
  seoKeywordsFr String?  @db.Text
  seoKeywordsAr String?  @db.Text
  seoKeywordsEn String? @db.Text
  geoRegion    String?  @db.Text
  geoCity      String?  @db.Text

  tab         ProductTab       @relation(fields: [tabId], references: [id])
  category    ProductCategory? @relation(fields: [categoryId], references: [id])
  productSpecs ProductSpec[]

  @@index([tabId])
  @@index([categoryId])
  @@index([status])
  @@map("products")

  favorites MemberFavorite[]
  shopProduct ShopProduct?
}


// ===== 在线商城（2026-09-06 深化三十三：mall 插件转正，B2B 询单制）=====
model ShopProduct {
  siteId       BigInt?  // 所属站点（null=全局共享）
  id           BigInt   @id @default(autoincrement())
  slug         String   @unique @db.VarChar(120)
  productId    BigInt?  @unique // 来源产品（产品同步上架，null=独立商品）
  name         String   @db.VarChar(200)
  nameEn       String?  @db.VarChar(200)
  nameJa       String?  @db.VarChar(200)
  nameKo       String?  @db.VarChar(200)
  nameFr       String?  @db.VarChar(200)
  nameAr       String?  @db.VarChar(200)
  summary      String?  @db.Text
  summaryEn    String?  @db.Text
  summaryJa    String?  @db.Text
  summaryKo    String?  @db.Text
  summaryFr    String?  @db.Text
  summaryAr    String?  @db.Text
  description  String?  @db.Text // 富文本/HTML
  descriptionEn String? @db.Text
  descriptionJa String? @db.Text
  descriptionKo String? @db.Text
  descriptionFr String? @db.Text
  descriptionAr String? @db.Text
  coverImage   String?  @db.VarChar(500)
  categoryId   BigInt? // 所属商城分类（null=未分类）
  images       Json?    // [{url, alt}]
  isParts      Boolean  @default(false) // 是否配件（配件价仅整机/配件客户可见）
  priceTiers   Json?    // [{qty, price}] 阶梯价（批量价），按数量取档
  specs        Json?    // 规格 [{name, nameEn, options:[{label, labelEn, price(增量), stock}]}]
  modelFiles   Json?    // 模型及图纸下载 [{name, url, size}]
  price        Decimal? @db.Decimal(12,2) // 售价（空=面议）
  originalPrice Decimal? @db.Decimal(12,2) // 划线原价（可空）
  unit         String?  @db.VarChar(20)   // 件/套/台
  stock        Int      @default(0)       // -1=不限
  minOrder     Int      @default(1)       // 最小起订
  status       String   @default("published") @db.VarChar(20) // published/draft
  featured     Boolean  @default(false)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  product      Product?  @relation(fields: [productId], references: [id])
  // 绑定的销售用户（销售仅可接待自己绑定产品的订单）
  salesUsers   User[]

  @@index([status])
  @@index([featured])
  @@index([categoryId])
  @@map("shop_products")
}

model ShopCategory {
  siteId       BigInt?  // 所属站点（null=全局共享）
  id           BigInt   @id @default(autoincrement())
  slug         String   @unique @db.VarChar(120)
  name         String   @db.VarChar(200)
  nameEn       String?  @db.VarChar(200)
  nameJa       String?  @db.VarChar(200)
  nameKo       String?  @db.VarChar(200)
  nameFr       String?  @db.VarChar(200)
  nameAr       String?  @db.VarChar(200)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("shop_categories")
}

model ShopOrder {
  siteId       BigInt?
  id           BigInt   @id @default(autoincrement())
  orderNo      String   @unique @db.VarChar(40)
  memberId     BigInt?  // 登录会员下单时关联（游客为 null）
  // 客户信息
  name         String   @db.VarChar(100)
  phone        String   @db.VarChar(50)
  email        String   @db.VarChar(200)
  company      String?  @db.VarChar(200)
  address      String?  @db.VarChar(500)
  remark       String?  @db.Text
  // 商品明细 [{id, slug, name, nameEn, price, qty, unit, cover}]
  items        Json
  amount       Decimal  @db.Decimal(14,2)
  currency     String   @default("CNY") @db.VarChar(10)
  status       String   @default("pending") @db.VarChar(20) // pending/confirmed/completed/cancelled
  payMethod    String   @db.VarChar(50) // offline(线下转账)/bank(对公汇款)/contact(联系销售)/wechat/alipay
  ipInfo       Json?    // {ip, country, city}
  // 发货信息（confirmed 后可填写；shippingCompany 存物流商 code：SF=顺丰速运 / KY=跨越速运 / JD=京东物流）
  shippingCompany String? @db.VarChar(100)
  trackingNo      String? @db.VarChar(100)
  shippedAt       DateTime?
  shippingStatus  String   @default("not_shipped") @db.VarChar(20) // not_shipped/shipped/delivered
  deliveredAt     DateTime?
  // 优惠券（couponCode=券码，discountAmount=优惠金额，实付=amount-discountAmount）
  couponCode     String?  @db.VarChar(40)
  // 发票与采购订单
  poNo          String?  @db.VarChar(60)  // 客户采购单号
  invoiceTitle  String?  @db.VarChar(200) // 发票抬头
  taxNo         String?  @db.VarChar(100) // 税号
  // 支付状态（bank/offline 对公转账）
  payStatus     String   @default("unpaid") @db.VarChar(20) // unpaid/paid/confirmed
  payVoucher    String?  @db.VarChar(500) // 转账凭证图片 URL
  paidAt        DateTime?
  discountAmount Decimal  @default(0) @db.Decimal(14,2)
  // 销售跟进（分配/响应/2小时轮转）
  salesUserId   BigInt?  // 当前负责跟进的销售 User id
  salesUser     User?    @relation("ShopOrderSales", fields: [salesUserId], references: [id])
  assignedAt    DateTime? // 分配时间（轮转后重置为轮转时刻）
  respondedAt   DateTime? // 销售标记跟进/状态变更时间（非空则停止轮转）
  escalationCount Int    @default(0) // 已轮转次数
  // 操作历史 [{status, at, note}] 状态流转轨迹
  history      Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([status])
  @@index([email])
  @@index([memberId])
  @@map("shop_orders")
}

model ProductSpec {
  id        BigInt   @id @default(autoincrement())
  siteId    BigInt?  // 所属站点（null=全局共享）
  productId BigInt
  groupName String?  @db.VarChar(255) // 规格分组
  label     String   @db.VarChar(255) // 参数名（中文）
  value     String   @db.Text // 参数值（中文）
  unit      String?  @db.VarChar(80)
  // 多语言字段
  labelEn   String?  @db.VarChar(255)
  labelJa   String?  @db.VarChar(255)
  labelKo   String?  @db.VarChar(255)
  labelFr   String?  @db.VarChar(255)
  labelAr   String?  @db.VarChar(255)
  valueEn   String?  @db.Text
  valueJa   String?  @db.Text
  valueKo   String?  @db.Text
  valueFr   String?  @db.Text
  valueAr   String?  @db.Text
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_specs")
}

// ============================================================
// 3. 配置域
// ============================================================

model SiteConfig {
  id          BigInt   @id @default(autoincrement())
  configKey   String   @unique @db.VarChar(100)
  configValue Json?
  remark      String?  @db.VarChar(200)
  updatedAt   DateTime @updatedAt

  @@map("site_config")
}

// 多租户站点级配置覆盖（siteId 维度，优先于全局 site_config）
model SiteConfigOverride {
  id          BigInt   @id @default(autoincrement())
  siteId      BigInt
  configKey   String   @db.VarChar(100)
  configValue Json?
  updatedAt   DateTime @updatedAt

  @@unique([siteId, configKey])
  @@map("site_config_override")
}

model ThemeConfig {
  id           BigInt   @id @default(autoincrement())
  siteId       BigInt?  // 所属站点（null=全局共享）
  primary      String   @default("#CC0000") @db.VarChar(7)
