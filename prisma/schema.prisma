  value      String?  @db.VarChar(500)
  url        String?  @db.VarChar(255)
  createdAt  DateTime @default(now())

  visitor AnalyticsVisitor @relation(fields: [visitorId], references: [id], onDelete: Cascade)

  @@index([visitorId])
  @@index([type])
  @@index([createdAt])
  @@map("analytics_events")
}

