  exitedAt  DateTime?
  createdAt DateTime @default(now())

  visitor AnalyticsVisitor @relation(fields: [visitorId], references: [id], onDelete: Cascade)

  @@index([visitorId])
  @@index([path])
  @@index([enteredAt])
  @@map("analytics_page_views")
}

model AnalyticsEvent {
  id         BigInt   @id @default(autoincrement())
  visitorId  BigInt
  pageViewId BigInt? // 关联的页面浏览
  type       String   @db.VarChar(20) // click/scroll/form/search/download/custom
  category   String?  @db.VarChar(50) // button/link/nav/form/search/scroll/download
  action     String?  @db.VarChar(100)
