model Faq {
  siteId       BigInt?  // 所属站点（null=全局共享，多租户数据隔离）
  id         BigInt   @id @default(autoincrement())
  question   String   @db.VarChar(500)
  questionEn String?  @db.VarChar(500)
  questionJa String?  @db.VarChar(500)
  questionKo String?  @db.VarChar(500)
  questionFr String?  @db.VarChar(500)
  questionAr String?  @db.VarChar(500)
  answer     String   @db.Text
  answerEn   String?  @db.Text
  answerJa   String?  @db.Text
  answerKo   String?  @db.Text
  answerFr   String?  @db.Text
  answerAr   String?  @db.Text
  category   String?  @db.VarChar(100)
  sortOrder  Int      @default(0)
  status     String   @default("published") @db.VarChar(20)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([status])
  @@map("faqs")
}

model AiKnowledge {
  id         BigInt   @id @default(autoincrement())
  title      String   @db.VarChar(500)
  titleEn    String?  @db.VarChar(500)
  titleJa    String?  @db.VarChar(500)
  titleKo    String?  @db.VarChar(500)
  titleFr    String?  @db.VarChar(500)
  titleAr    String?  @db.VarChar(500)
  content    String   @db.Text
  contentEn  String?  @db.Text
  contentJa  String?  @db.Text
  contentKo  String?  @db.Text
  contentFr  String?  @db.Text
  contentAr  String?  @db.Text
  category   String?  @db.VarChar(100)
  tags       String?  @db.VarChar(300)
  source     String   @default("manual") @db.VarChar(20)
  status     String   @default("published") @db.VarChar(20)
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([status, category])
  @@map("ai_knowledge")
}


// ============================================================
// 外链回链管理（SEO 数据回链：第三方平台发文回链本站）
// ============================================================
model Backlink {
  id          BigInt    @id @default(autoincrement())
  platform    String    @db.VarChar(100)
  platformType String   @db.VarChar(50) @default("other")
  title       String?   @db.VarChar(300)
  url         String    @db.VarChar(500)
  targetUrl   String    @db.VarChar(300)
  status      String    @db.VarChar(30) @default("planned")
  priority    Int       @default(3)
  keyword     String?   @db.VarChar(200)
  note        String?   @db.Text
  publishDate DateTime?
  checkDate   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("backlinks")

  
}

  // 外链营销引擎 · 软文（针对某条外链生成/编辑/发布追踪的营销文案）
  model BacklinkPost {
    id          BigInt    @id @default(autoincrement())
    backlinkId  BigInt?
    platform    String    @db.VarChar(100)
    platformType String   @db.VarChar(50) @default("other")
    title       String    @db.VarChar(400)
    // 多语言正文 {zh,en,ja,ko,fr,ar}
    content     Json      @default("{}")
    status      String    @db.VarChar(30) @default("draft") // draft / published / failed
    publishUrl  String?   @db.VarChar(600)
    targetUrl   String?   @db.VarChar(400)
    aiGenerated Boolean   @default(false)
    publishedAt DateTime?
    createdAt   DateTime  @default(now())
    updatedAt   DateTime  @updatedAt
  
    @@map("backlink_posts")
  }


// ============================================================
// 通用内容架构 P3 · 动态内容类型（后台可视化定义新栏目，无需改代码）
// ============================================================

model FormDefinition {
  id           BigInt   @id @default(autoincrement())
  name         String   @db.VarChar(100)
  slug         String   @unique @db.VarChar(100)
  title        Json     // 多语言 {zh,en,ja,ko,fr,ar}
  description  Json?    // 多语言
  fields       Json     // [{key,label:{zh,en,...},type,required,options:[{label:{...},value}]}]
  submitLabel  Json?    // 提交按钮文字
  status       String   @default("active") @db.VarChar(20) // active/inactive
  submitCount  BigInt   @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  submissions FormSubmission[]
    @@map("form_definitions")
}

model FormSubmission {
  id        BigInt   @id @default(autoincrement())
  formId    BigInt
  form      FormDefinition @relation(fields: [formId], references: [id], onDelete: Cascade)
  fieldData Json     // {key: value}
  ip        String?  @db.VarChar(64)
  country   String?  @db.VarChar(100)
  city      String?  @db.VarChar(100)
  createdAt DateTime @default(now())
  @@map("form_submissions")
}

model ContentTypeDef {
  id           BigInt   @id @default(autoincrement())
  name         String   @unique @db.VarChar(50)
  label        String   @db.VarChar(100)
  labelEn      String?  @db.VarChar(100)
  description  String?  @db.Text
  fields       Json
  listColumns  Json
  titleField   String   @db.VarChar(50)
  slugField    String?  @db.VarChar(50)
  enableSeo    Boolean  @default(false)
  enableStatus Boolean  @default(false)
  sortOrder    Int      @default(0)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("content_type_defs")
}

model DynamicContent {
  siteId      BigInt?   // 所属站点（null=全局共享，多租户数据隔离）
  id          BigInt    @id @default(autoincrement())
  type        String    @db.VarChar(50)
  slug        String    @db.VarChar(200)
  title       String    @db.VarChar(300)
  fields      Json
  status      String    @db.VarChar(30) @default("draft")
  sortOrder   Int       @default(0)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([type, status])
  @@index([type, slug])
  @@map("dynamic_contents")
}


// ============================================================
// R1 多租户基座 · 租户与站点（轻量多租户，存量数据归属默认租户 tenantId=1 兜底）
// ============================================================

model Tenant {
  id          BigInt   @id @default(autoincrement())
  name        String   @db.VarChar(100)   // 租户名称（客户名/公司名）
  slug        String   @unique @db.VarChar(100) // 租户标识
  edition     String   @default("standard") @db.VarChar(30) // trial/standard/pro/enterprise
  status      String   @default("active") @db.VarChar(20)
  licenseCode String?  @db.VarChar(500)   // 绑定授权码（与站点名称/域名联动）
  maxSites    Int      @default(1)
  maxSeats    Int      @default(5)
  expiresAt   DateTime? // 授权到期时间
  contactName String?  @db.VarChar(100)
  contactEmail String? @db.VarChar(200)
  remark      String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  sites Site[]
  @@map("tenants")
}

model Site {
  id          BigInt   @id @default(autoincrement())
  tenantId    BigInt   @default(1)
  industryPack      String?  @db.VarChar(100) // 当前安装行业包 slug
  industryPackVersion String? @db.VarChar(30)  // 当前行业包版本
  name        String   @db.VarChar(100)   // 站点名称
  domain      String?  @unique @db.VarChar(200) // 主域名（host 解析）
  domains     Json?    // 附加域名列表（白标多域名）
  templateSlug String  @default("default") @db.VarChar(100) // 前台模板
  themeConfig Json?    // 站点级主题覆盖（{primary, accent, ...}）
  logo        String?  @db.VarChar(500)
  favicon     String?  @db.VarChar(500)
  locale      String   @default("zh") @db.VarChar(10) // 默认语种
  status      String   @default("active") @db.VarChar(20)
  isDefault   Boolean  @default(false) // 默认站点（存量数据归属）
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])
  @@index([tenantId])
  @@map("sites")
}

// 行业包安装历史记录（pack-cli 安装/卸载/升级时写入）
model IndustryPackRecord {
  id         BigInt   @id @default(autoincrement())
  siteId     BigInt
  packKey    String   @db.VarChar(100)
  packVersion String  @db.VarChar(30)
  action     String   @db.VarChar(20) // install / uninstall / upgrade
  operatorId BigInt?
  result     Json?
  createdAt  DateTime @default(now())

  @@index([siteId, packKey])
  @@map("industry_pack_records")
}

model ShopCoupon {
  id          BigInt    @id @default(autoincrement())
  siteId      BigInt?
  code        String    @unique @db.VarChar(40) // 券码（领券中心领取用）
  name        String    @db.VarChar(100)
  nameEn      String?   @db.VarChar(200)
  nameJa      String?   @db.VarChar(200)
  nameKo      String?   @db.VarChar(200)
  nameFr      String?   @db.VarChar(200)
  nameAr      String?   @db.VarChar(200)
  type        String    @default("fixed") @db.VarChar(20) // fixed 满减 | percent 折扣
  amount      Decimal   @db.Decimal(14,2) // 满减金额 或 折扣率(90=9折)
  minAmount   Decimal   @default(0) @db.Decimal(14,2) // 使用门槛
  maxDiscount Decimal?  @db.Decimal(14,2) // percent 封顶优惠额
  startAt     DateTime?
  endAt       DateTime?
  total       Int       @default(0) // 发行总量 0=不限
  claimed     Int       @default(0)
  perUser     Int       @default(1) // 每人限领
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  @@index([isActive])
  @@map("shop_coupons")
}

model ShopCouponClaim {
  id        BigInt    @id @default(autoincrement())
  couponId  BigInt
  memberId  BigInt?   // 游客不可领券（null 不出现）
  code      String    @db.VarChar(40)
  used      Boolean   @default(false)
  usedAt    DateTime?
  orderNo   String?   @db.VarChar(40)
  createdAt DateTime  @default(now())
  @@index([couponId])
  @@index([memberId])
  @@map("shop_coupon_claims")
}

