interface MenuChild {
  label: string
  href: string
  permission?: string
  /** 依赖插件 key：插件停用时隐藏（/api/admin/plugins?mode=enabled 控制） */
  plugin?: string
  /** 二级子项（如 询价报价→报价单模板、会员中心→等级权益）；仅用于带子页的菜单项 */
  children?: { label: string; href: string }[]
}

interface MenuItem {
  label: string
  href: string
  icon: React.ReactNode
  permission?: string
  /** 依赖插件 key：插件停用时隐藏（/api/admin/plugins?mode=enabled 控制） */
  plugin?: string
  /** 分组标识：动态插件入口按 category 归入对应分组（仅分组父项设置） */
  groupKey?: string
  children?: MenuChild[]
}

/** 插件侧边栏元信息（/api/admin/plugins?mode=enabled 返回） */
interface PluginSidebarMeta {
  key: string
  name: string
  showInSidebar: boolean
  adminUrl?: string | null
  adminUrls?: { label: string; href: string }[] | null
  isContentSection?: boolean
  planned?: boolean
  category?: string
}

/** 动态插件入口（按 category 归入对应分组） */
interface DynamicPluginChild {
  label: string
  href: string
  plugin?: string
  pluginKey?: string
  children?: { label: string; href: string }[]
}

